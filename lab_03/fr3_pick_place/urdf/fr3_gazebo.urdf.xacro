<?xml version="1.0" encoding="utf-8"?>
<!-- FR3 with Franka Hand in Gazebo Harmonic, position-controlled through gz_ros2_control. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr3">
  <xacro:arg name="robot_type" default="fr3"/>
  <xacro:arg name="hand" default="true"/>
  <xacro:arg name="ee_id" default="franka_hand"/>
  <xacro:arg name="gazebo" default="true"/>
  <xacro:arg name="controllers_file" default=""/>

  <xacro:include filename="$(find franka_description)/robots/fr3/fr3.urdf.xacro"/>

  <xacro:macro name="arm_joint" params="name initial">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:arm_joint name="fr3_joint1" initial="0.0"/>
    <xacro:arm_joint name="fr3_joint2" initial="${-pi/4}"/>
    <xacro:arm_joint name="fr3_joint3" initial="0.0"/>
    <xacro:arm_joint name="fr3_joint4" initial="${-3*pi/4}"/>
    <xacro:arm_joint name="fr3_joint5" initial="0.0"/>
    <xacro:arm_joint name="fr3_joint6" initial="${pi/2}"/>
    <xacro:arm_joint name="fr3_joint7" initial="${pi/4}"/>
    <xacro:arm_joint name="fr3_finger_joint1" initial="0.0"/>
    <joint name="fr3_finger_joint2">
      <param name="mimic">fr3_finger_joint1</param>
      <param name="multiplier">1</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>
</robot>
