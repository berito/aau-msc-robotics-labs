<?xml version="1.0" encoding="utf-8"?>
<!-- FR3 with Franka Hand on mock hardware, with a commandable finger joint. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr3">
  <xacro:arg name="robot_type" default="fr3"/>
  <xacro:arg name="hand" default="true"/>
  <xacro:arg name="ee_id" default="franka_hand"/>

  <xacro:include filename="$(find franka_description)/robots/fr3/fr3.urdf.xacro"/>
  <xacro:include filename="$(find franka_hardware)/ros2_control/franka_arm.ros2_control.xacro"/>

  <xacro:franka_arm_ros2_control
      robot_type="fr3"
      include_effort_command="false"
      include_finger_joint="true"
      arm_prefix="">
    <hardware_plugin>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="mock_sensor_commands">false</param>
      <param name="state_following_offset">0.0</param>
    </hardware_plugin>
  </xacro:franka_arm_ros2_control>
</robot>
